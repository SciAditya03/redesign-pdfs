# Copy to backend/.env and fill in. Never commit backend/.env.

# Google Gemini (https://aistudio.google.com/apikey). Server-side only; never exposed to the browser.
GEMINI_API_KEY=
# Required. Model IDs change often, so there is no default. List the models your key can use:
#   python scripts/list_gemini_models.py
# Pick a current Pro-class model with PDF input support (see https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=
# Per-request timeout. Deep analysis of long PDFs can take several minutes.
GEMINI_TIMEOUT_SECONDS=600
GEMINI_MAX_RETRIES=3
# Upper bound for each analysis stage's JSON output. Lower it if your model's output limit is smaller.
GEMINI_MAX_OUTPUT_TOKENS=65536

DATA_DIR=./data
# Gemini's Files API accepts PDFs up to 50 MB.
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JOB_WORKERS=2
